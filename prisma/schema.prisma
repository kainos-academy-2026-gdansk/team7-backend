generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobRole {
  id          Int       @id @default(autoincrement())
  roleName    String
  location    String
  closingDate DateTime?

  description           String?
  responsibilities      String?
  sharepointUrl         String?
  numberOfOpenPositions Int?

  statusId     Int
  bandId       Int
  capabilityId Int

  status     Status     @relation(fields: [statusId], references: [statusId])
  band       Band       @relation(fields: [bandId], references: [id])
  capability Capability @relation(fields: [capabilityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statusId])
  @@index([capabilityId])
  @@index([bandId])
}

model Band {
  id   Int    @id @default(autoincrement())
  name String @unique

  jobRoles JobRole[]
}

model Capability {
  id   Int    @id @default(autoincrement())
  name String @unique

  jobRoles JobRole[]
}

model Status {
  statusId   Int    @id @default(autoincrement())
  statusName String @unique

  jobRoles JobRole[]
}
